{
  "name": "idorbite",
  "version": "0.1.0",
  "description": "Static scanner that flags sibling-handler authorization gaps (IDOR / Broken Object Level Authorization) in JS/TS web backends.",
  "type": "module",
  "bin": {
    "idorbite": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "security",
    "sast",
    "idor",
    "bola",
    "authorization",
    "static-analysis",
    "appsec",
    "nestjs",
    "nextjs",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "12.1.0",
    "picocolors": "1.1.1",
    "ts-morph": "24.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
